load("@valdi//bzl/valdi:valdi_module.bzl", "valdi_module")

valdi_module(
    name = "compose_core",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        "test/**/*.tsx",
    ]) + [
        "tsconfig.json",
    ],
    android_output_target = "release",
    ids_yaml = "ids.yaml",
    ios_module_name = "ComposeCore",
    ios_output_target = "release",
    res = [],
    visibility = ["//visibility:public"],
    deps = [
        "@valdi//src/valdi_modules/src/valdi/jasmine",
        "@valdi//src/valdi_modules/src/valdi/valdi_core",
        "@valdi//src/valdi_modules/src/valdi/valdi_tsx",
    ],
)

sh_test(
    name = "compose_core_placeholder_test",
    srcs = ["test/placeholder_test.sh"],
    data = [
        "src/foundation/Button.tsx",
        "src/foundation/ControlTheme.ts",
        "src/foundation/SegmentedControl.tsx",
        "src/foundation/Select.tsx",
        "src/foundation/Slider.tsx",
        "src/foundation/TabBar.tsx",
        "src/foundation/TextField.tsx",
        "src/foundation/Toggle.tsx",
        "src/layout/Box.tsx",
        "src/layout/Column.tsx",
        "src/layout/Row.tsx",
        "src/layout/Spacer.tsx",
    ],
)

sh_test(
    name = "foundation_correctness_test",
    srcs = ["test/foundation_correctness_test.sh"],
    data = [
        "src/foundation/Card.tsx",
        "src/foundation/Text.tsx",
        "src/index.ts",
        "src/layout/LazyList.tsx",
    ],
)

sh_test(
    name = "controlled_controls_contract_test",
    srcs = ["test/controlled_controls_contract_test.sh"],
    data = [
        "ids.yaml",
        "src/foundation/Button.tsx",
        "src/foundation/ControlTheme.ts",
        "src/foundation/SegmentedControl.tsx",
        "src/foundation/Select.tsx",
        "src/foundation/Slider.tsx",
        "src/foundation/TabBar.tsx",
        "src/foundation/TextField.tsx",
        "src/foundation/Toggle.tsx",
        "src/index.ts",
        "test/ControlledControls.spec.ts",
        "test/index.test.ts",
    ],
)
