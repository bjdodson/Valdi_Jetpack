load("@valdi//bzl/valdi:valdi_module.bzl", "valdi_module")

objc_library(
    name = "macos_directory_picker",
    srcs = ["macos/VJComposeDirectoryPickerButton.m"],
    alwayslink = True,
    deps = ["@valdi//valdi"],
)

objc_library(
    name = "macos_image_export",
    srcs = ["macos/VJComposeImageExportBridge.m"],
    alwayslink = True,
    sdk_frameworks = ["ImageIO"],
    weak_sdk_frameworks = ["UniformTypeIdentifiers"],
    deps = ["@valdi//valdi"],
)

valdi_module(
    name = "compose_core",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        "test/**/*.tsx",
    ]) + [
        "tsconfig.json",
    ],
    android_output_target = "release",
    ids_yaml = "ids.yaml",
    ios_module_name = "ComposeCore",
    ios_output_target = "release",
    macos_deps = [
        ":macos_directory_picker",
        ":macos_image_export",
    ],
    res = [],
    visibility = ["//visibility:public"],
    deps = [
        "@valdi//src/valdi_modules/src/valdi/jasmine",
        "@valdi//src/valdi_modules/src/valdi/valdi_core",
        "@valdi//src/valdi_modules/src/valdi/valdi_tsx",
    ],
)

